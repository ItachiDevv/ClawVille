{
  "name": "clawville",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "bun run --filter @clawville/database migrate",
    "db:push": "bun run --filter @clawville/database push",
    "db:seed": "bun run scripts/seed-locations.ts",
    "db:seed:quests": "bun run scripts/seed-quests.ts",
    "db:studio": "bun run --filter @clawville/database studio",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:mock-gateway": "bun run scripts/mock-openclaw.ts",
    "test:agent-flow": "bun run scripts/test-agent-flow.ts",
    "deploy:cf-secrets": "cd infra/cf-secrets-worker && bunx wrangler deploy",
    "assets:optimize": "bun run scripts/assets-optimize.ts",
    "perf:fidelity:assets": "bun run scripts/perf-fidelity-asset-audit.ts",
    "perf:fidelity:browser": "bun run scripts/perf-fidelity-browser.ts",
    "perf:fidelity:variants": "bun run scripts/perf-fidelity-variant-plan.ts"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@types/node": "^20.11.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.4.1",
    "draco3d": "^1.5.7",
    "gifenc": "^1.0.3",
    "gltf-pipeline": "^4.3.1",
    "meshoptimizer": "^1.1.1",
    "obs-websocket-js": "^5.0.7",
    "postcss": "^8.5.8",
    "prettier": "^3.2.0",
    "puppeteer-core": "^24.38.0",
    "sharp": "^0.34.5",
    "tailwindcss": "3",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3",
    "ws": "^8.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@types/three": "^0.185.0",
    "@bonfida/spl-name-service": "file:./vendor/npm/bonfida-spl-name-service-3.0.23.tgz"
  },
  "packageManager": "bun@1.0.25",
  "dependencies": {
    "@clawville/database": "workspace:*",
    "@clawville/shared": "workspace:*",
    "@clawville/wager-program": "workspace:*",
    "@coral-xyz/anchor": "^0.31.1",
    "@payai/facilitator": "2.4.4",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0",
    "pg": "^8.17.2",
    "three-stdlib": "^2.36.1",
    "tweetnacl": "^1.0.3"
  }
}