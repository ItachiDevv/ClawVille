{
  "name": "elizapets",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "bun run --filter @elizapets/database migrate",
    "db:push": "bun run --filter @elizapets/database push",
    "db:seed": "bun run scripts/seed-locations.ts",
    "db:seed:quests": "bun run scripts/seed-quests.ts",
    "db:studio": "bun run --filter @elizapets/database studio",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:mock-gateway": "bun run scripts/mock-openclaw.ts",
    "test:agent-flow": "bun run scripts/test-agent-flow.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.4.1",
    "gifenc": "^1.0.3",
    "obs-websocket-js": "^5.0.7",
    "postcss": "^8.5.8",
    "prettier": "^3.2.0",
    "puppeteer-core": "^24.38.0",
    "sharp": "^0.34.5",
    "tailwindcss": "3",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.0.25",
  "dependencies": {
    "pg": "^8.17.2",
    "three-stdlib": "^2.36.1"
  }
}
