          "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Priors</title>\n<style>\n  :root { color-scheme: light dark; --bg: var(--color-background-primary, Canvas); --fg: var(--color-text-primary, CanvasText);\n    --mute: var(--color-text-secondary, GrayText); --line: var(--color-border-primary, color-mix(in srgb, CanvasText 15%, transparent));\n    --accent: #2f6b4f; --bad: #a9432c; font-family: var(--font-sans, system-ui, sans-serif); }\n  body { margin: 0; background: transparent; color: var(--fg); font-size: 14px; line-height: 1.45; }\n  .wrap { padding: 14px 16px; max-width: 640px; }\n  h1 { font-size: 17px; margin: 0 0 2px; } .sub { color: var(--mute); font-size: 12.5px; }\n  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; margin: 12px 0; }\n  .k { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; } .k b { display: block; font-size: 16px; } .k span { color: var(--mute); font-size: 12px; }\n  .bad { color: var(--bad); font-weight: 600; } .ok { color: var(--accent); }\n  ul { margin: 6px 0 0; padding-left: 18px; } li { margin: 2px 0; }\n  form, .act { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--line); }\n  input, select { font: inherit; padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--fg); }\n  input[type=number] { width: 110px; } button { font: inherit; padding: 7px 12px; border-radius: 6px; border: 1px solid var(--line); background: var(--bg); color: var(--fg); cursor: pointer; }\n  button.primary { background: var(--accent); border-color: var(--accent); color: #fff; } button:disabled { opacity: .5; cursor: default; }\n  .note { margin-top: 10px; font-size: 12.5px; color: var(--mute); } .err { margin-top: 10px; color: var(--bad); }\n  .link { word-break: break-all; font-size: 12px; color: var(--mute); }\n</style>\n</head>\n<body>\n<div class=\"wrap\" id=\"root\"><p class=\"sub\">Loading the Priors record…</p></div>\n<script>\n(() => {\n  \"use strict\";\n  const root = document.getElementById(\"root\");\n  let nextId = 1;\n  const pending = new Map();\n  const send = (msg) => window.parent.postMessage(msg, \"*\");\n  const request = (method, params) => new Promise((resolve, reject) => {\n    const id = nextId++;\n    pending.set(id, { resolve, reject });\n    send({ jsonrpc: \"2.0\", id, method, params });\n  });\n  const notify = (method, params) => send({ jsonrpc: \"2.0\", method, ...(params ? { params } : {}) });\n\n  // The view only builds text nodes from data: nothing a tool returns becomes HTML.\n  const el = (tag, attrs, ...kids) => {\n    const n = document.createElement(tag);\n    for (const [k, v] of Object.entries(attrs || {})) if (v != null && v !== false) n.setAttribute(k, v === true ? \"\" : String(v));\n    for (const c of kids.flat()) if (c != null && c !== false) n.append(c instanceof Node ? c : document.createTextNode(String(c)));\n    return n;\n  };\n  const show = (...nodes) => { root.replaceChildren(...nodes); resize(); };\n  const resize = () => { const r = document.documentElement.getBoundingClientRect(); notify(\"ui/notifications/size-changed\", { width: Math.ceil(r.width), height: Math.ceil(r.height) }); };\n  const failure = (text) => el(\"p\", { class: \"err\", role: \"alert\" }, text);\n  const textOf = (res) => (res && Array.isArray(res.content) ? res.content.filter((c) => c.type === \"text\").map((c) => c.text).join(\"\\n\") : \"\");\n\n  async function call(name, args) {\n    const res = await request(\"tools/call\", { name, arguments: args });\n    if (res && res.isError) throw new Error(textOf(res) || \"the tool returned an error\");\n    return res;\n  }\n  async function openLink(url) {\n    try { await request(\"ui/open-link\", { url }); return true; } catch (_) { return false; }\n  }\n\n  // Two places confirm a request: Go mode (the owner's account) and Builder mode (the wallet that owns the agent)\n  function approval(data, label) {\n    const out = el(\"div\", { class: \"act\" });\n    const fallback = el(\"p\", { class: \"note\", hidden: true });\n    const button = (text, url, primary) => {\n      const btn = el(\"button\", primary ? { class: \"primary\", type: \"button\" } : { type: \"button\" }, text);\n      btn.addEventListener(\"click\", async () => {\n        btn.disabled = true;\n        if (!(await openLink(url))) { fallback.replaceChildren(\"The app did not open the link. Open it yourself: \", el(\"span\", { class: \"link\" }, url)); fallback.hidden = false; }\n        btn.disabled = false; resize();\n      });\n      return btn;\n    };\n    out.append(button(label, data.approvalUrl, true));\n    if (data.builderUrl) out.append(button(\"Confirm with your wallet\", data.builderUrl, false));\n    out.append(el(\"p\", { class: \"note\" }, \"Nothing moves until the agent's owner confirms it: in Go mode, signed in with their own account, or in Builder mode with the wallet that owns the agent.\"), fallback);\n    return out;\n  }\n\n  function borrowForm(r) {\n    const amount = el(\"input\", { type: \"number\", min: \"0\", step: \"0.01\", value: \"5\", \"aria-label\": \"Amount in USDG\" });\n    const days = el(\"select\", { \"aria-label\": \"Days\" }, [7, 14, 30].map((d) => el(\"option\", { value: d }, d + \" days\")));\n    const go = el(\"button\", { class: \"primary\", type: \"submit\" }, \"Ask to borrow\");\n    const msg = el(\"div\");\n    const form = el(\"form\", {}, el(\"span\", {}, \"Borrow\"), amount, el(\"span\", {}, \"USDG for\"), days, go, msg);\n    form.addEventListener(\"submit\", async (e) => {\n      e.preventDefault(); go.disabled = true; msg.replaceChildren();\n      try {\n        const res = await call(\"request_borrow\", { agent_id: r.agentId, amount_usd: Number(amount.value), days: Number(days.value) });\n        msg.replaceChildren(requestView(res.structuredContent, textOf(res)));\n      } catch (err) { msg.replaceChildren(failure(err.message)); }\n      go.disabled = false; resize();\n    });\n    return form;\n  }\n\n  function repayButton(r) {\n    const go = el(\"button\", { type: \"button\" }, \"Ask to repay\");\n    const msg = el(\"div\");\n    go.addEventListener(\"click\", async () => {\n      go.disabled = true; msg.replaceChildren();\n      try { const res = await call(\"request_repay\", { agent_id: r.agentId }); msg.replaceChildren(requestView(res.structuredContent, textOf(res))); }\n      catch (err) { msg.replaceChildren(failure(err.message)); }\n      go.disabled = false; resize();\n    });\n    return el(\"div\", { class: \"act\" }, go, msg);\n  }\n\n  function lookup() {\n    const id = el(\"input\", { type: \"number\", min: \"0\", step: \"1\", placeholder: \"agent id\", \"aria-label\": \"Agent id\" });\n    const go = el(\"button\", { type: \"submit\" }, \"Show record\");\n    const form = el(\"form\", {}, id, go);\n    form.addEventListener(\"submit\", async (e) => {\n      e.preventDefault(); if (id.value === \"\") return; go.disabled = true;\n      try { const res = await call(\"agent_record\", { agent_id: Number(id.value) }); render(res); }\n      catch (err) { form.append(failure(err.message)); resize(); }\n      go.disabled = false;\n    });\n    return form;\n  }\n\n  function recordView(r) {\n    const status = r.defaulted ? el(\"span\", { class: \"bad\" }, \"Defaulted: it can never borrow again\") : r.frozen ? el(\"span\", { class: \"bad\" }, \"Frozen\") : el(\"span\", { class: \"ok\" }, \"Never defaulted\");\n    const loans = r.openLoans && r.openLoans.length\n      ? el(\"div\", {}, el(\"b\", {}, \"Open loans\"), el(\"ul\", {}, r.openLoans.map((l) => el(\"li\", {}, \"#\" + l.loanId + \": \" + l.due + \" USDG due \" + (l.dueAt || \"\") + (l.pastDue ? \" (PAST DUE)\" : \"\")))))\n      : el(\"p\", { class: \"sub\" }, \"No open loan.\");\n    const canBorrow = !r.defaulted && !r.frozen && !r.isRoot && Number(r.available) > 0;\n    return el(\"div\", {},\n      el(\"h1\", {}, \"Agent #\" + r.agentId + (r.name ? \" \" + r.name : \"\")),\n      el(\"div\", { class: \"sub\" }, r.backer ? \"Backed by #\" + r.backer.agentId + (r.backer.name ? \" \" + r.backer.name : \"\") : r.isRoot ? \"A backer (root)\" : \"No backer yet\"),\n      el(\"div\", { class: \"grid\" },\n        el(\"div\", { class: \"k\" }, el(\"b\", {}, r.score != null ? r.score + \"/1000\" : \"—\"), el(\"span\", {}, \"Score\")),\n        el(\"div\", { class: \"k\" }, el(\"b\", {}, r.available + \" USDG\"), el(\"span\", {}, \"Available of \" + r.line)),\n        el(\"div\", { class: \"k\" }, el(\"b\", {}, r.drawn + \" USDG\"), el(\"span\", {}, \"Drawn\")),\n        el(\"div\", { class: \"k\" }, el(\"b\", {}, String(r.loansRepaid)), el(\"span\", {}, \"Loans repaid\"))),\n      el(\"p\", {}, status),\n      loans,\n      canBorrow ? borrowForm(r) : null,\n      r.openLoans && r.openLoans.length ? repayButton(r) : null,\n      el(\"p\", { class: \"note\" }, \"Priors snapshot as of \" + (r.asOf || \"now\") + \". Another agent:\"),\n      lookup());\n  }\n\n  function requestView(d, text) {\n    if (!d || !d.approvalUrl) return el(\"p\", {}, text);\n    const label = d.kind === \"repay_request\" ? \"Repay in Go mode\" : \"Confirm in Go mode\";\n    const what = d.kind === \"repay_request\"\n      ? \"Repay agent #\" + d.agentId + \"'s open loan\" + (d.loans && d.loans.length > 1 ? \"s\" : \"\") + (d.due ? \" (\" + d.due + \" USDG due)\" : \"\")\n      : \"Borrow \" + d.amountUsd + \" USDG for \" + d.days + \" days for agent #\" + d.agentId + (d.feeEstimate ? \" (pool fee about \" + d.feeEstimate + \" USDG)\" : \"\");\n    return el(\"div\", {}, el(\"p\", {}, el(\"b\", {}, what)), approval(d, label));\n  }\n\n  function render(res) {\n    if (!res) return;\n    if (res.isError) return show(failure(textOf(res) || \"Priors could not answer.\"), lookup());\n    const d = res.structuredContent;\n    if (d && (d.kind === \"borrow_request\" || d.kind === \"repay_request\")) return show(requestView(d, textOf(res)));\n    if (d && d.agentId != null && d.line != null) return show(recordView(d));\n    show(el(\"p\", {}, textOf(res)), lookup());\n  }\n\n  window.addEventListener(\"message\", (e) => {\n    if (e.source !== window.parent) return;\n    const m = e.data;\n    if (!m || m.jsonrpc !== \"2.0\") return;\n    if (m.id != null && pending.has(m.id) && !m.method) {\n      const p = pending.get(m.id); pending.delete(m.id);\n      return m.error ? p.reject(new Error(m.error.message || \"error\")) : p.resolve(m.result);\n    }\n    if (m.method === \"ui/notifications/tool-result\") return render(m.params);\n    if (m.method === \"ui/notifications/host-context-changed\" && m.params && m.params.theme) document.documentElement.style.colorScheme = m.params.theme;\n    if (m.method === \"ui/resource-teardown\" && m.id != null) send({ jsonrpc: \"2.0\", id: m.id, result: {} });\n    if (m.method === \"ping\" && m.id != null) send({ jsonrpc: \"2.0\", id: m.id, result: {} });\n  });\n\n  request(\"ui/initialize\", { appCapabilities: { availableDisplayModes: [\"inline\"] }, appInfo: { name: \"priors\", version: \"0.3.0\" }, protocolVersion: \"2026-01-26\" })\n    .then((r) => {\n      const ctx = (r && r.hostContext) || {};\n      if (ctx.theme) document.documentElement.style.colorScheme = ctx.theme;\n      const vars = (ctx.styles && ctx.styles.variables) || {};\n      for (const [k, v] of Object.entries(vars)) if (v != null && /^--[a-z0-9-]+$/.test(k)) document.documentElement.style.setProperty(k, String(v));\n      notify(\"ui/notifications/initialized\");\n      resize();\n    })\n    .catch(() => show(failure(\"This view needs an MCP Apps host.\")));\n  if (typeof ResizeObserver === \"function\") new ResizeObserver(resize).observe(document.body);\n})();\n</script>\n</body>\n</html>",
