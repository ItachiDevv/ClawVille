# /etc/codex-decider.env  (root:codexd, mode 0640). Never commit the real file.
# Shared secret; the API container sends it as FLOOR_ARENA_CODEX_DECIDER_TOKEN. Generate: openssl rand -hex 32
CODEX_DECIDER_TOKEN=
# Model id for `codex exec -m` (empty = the codex default for the ChatGPT plan login).
CODEX_DECIDER_MODEL=
# IPv4:port. Use the gateway IP of the docker network the API container is on (README "Bind address"). Never 0.0.0.0.
CODEX_DECIDER_BIND=10.0.1.1:8790
# Hard deadline per request, queue wait included (ms). The API client waits 95000 ms.
CODEX_DECIDER_TIMEOUT_MS=90000
# Parallel codex exec runs.
CODEX_DECIDER_CONCURRENCY=2
# Optional: waiting requests before the oldest is dropped (default 8); reasoning effort (default low); codex binary.
# CODEX_DECIDER_QUEUE_MAX=8
# CODEX_DECIDER_EFFORT=low
# CODEX_DECIDER_BIN=codex
