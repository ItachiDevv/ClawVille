    "@clawville/database": "workspace:*",
    "@clawville/shared": "workspace:*",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.6.14",
    "lucia": "^3.2.2",
    "postgres": "^3.4.3",
    "uuid": "^9.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  }
}
