    "@clawville/wager-program": "workspace:*",
    "@coral-xyz/anchor": "^0.31.1",
    "@elizaos/plugin-sql": "2.0.0-alpha.7",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@solana/web3.js": "^1.95.0",
    "@x402/core": "^2.9.0",
    "@x402/hono": "^2.9.0",
    "@x402/svm": "^2.9.0",
    "bs58": "^6.0.0",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.6.14",
    "lucia": "^3.2.2",
    "postgres": "^3.4.3",
