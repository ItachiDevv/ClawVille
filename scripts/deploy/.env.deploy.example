# ClawVille Hetzner deploy — credentials template
#
# Copy this file to .env.deploy and fill in the values.
# .env.deploy is gitignored — never commit real tokens.
#
#   cp scripts/deploy/.env.deploy.example scripts/deploy/.env.deploy
#
# The scripts in this directory source .env.deploy when run.

# ─── Hetzner Cloud ─────────────────────────────────────────────────────────
# Create at https://console.hetzner.cloud → Security → API Tokens (Read & Write)
HCLOUD_TOKEN=

# Server config (defaults are cost-optimized for ClawVille)
SERVER_NAME=clawville-prod
SERVER_TYPE=ccx13        # 2 dedicated AMD vCPU / 8 GB / 80 GB NVMe — ~$14/mo
SERVER_LOCATION=ash      # ash=Ashburn VA, hil=Hillsboro OR, fsn1=Falkenstein, hel1=Helsinki, sin=Singapore
SERVER_IMAGE=ubuntu-24.04
SERVER_LABELS=project=clawville,managed-by=itachi-deploy

# ─── SSH ───────────────────────────────────────────────────────────────────
# Path to your PUBLIC key (e.g. ~/.ssh/id_ed25519.pub)
# If you don't have one yet:  ssh-keygen -t ed25519 -C "clawville-deploy"
SSH_KEY_NAME=clawville-deploy
SSH_KEY_PATH=~/.ssh/id_ed25519.pub

# ─── Cloudflare ────────────────────────────────────────────────────────────
# Create at https://dash.cloudflare.com/profile/api-tokens
#
# IMPORTANT: if you still need to ADD clawville.world to Cloudflare (i.e. the
# zone doesn't exist yet), the token must have account-level zone-create perms.
# Use a "Custom Token" with these permissions:
#
#     Zone → Zone        → Edit
#     Zone → DNS         → Edit
#     Zone Resources     → Include → All zones from an account → <your account>
#
# Once the zone exists you CAN narrow it to a specific-zone token, but a single
# token with the perms above works for both zone creation AND the later DNS
# record upserts, so just use one token for everything.
CF_API_TOKEN=
CF_ZONE_NAME=clawville.world

# ─── Namecheap (only needed for the one-time NS swap to Cloudflare) ────────
# Enable at https://ap.www.namecheap.com/settings/tools/apiaccess/
#   1. Toggle "API Access" ON (requires min. balance or 20+ domains on account)
#   2. Copy your API Key
#   3. Whitelist your current public IP in the "Whitelisted IPs" box
#      (the script will print your IP and tell you if it's missing)
#
# Your API user is usually the same as your Namecheap login username.
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=

# Subdomains for the staged migration.
# The script only ADDS these records — it never deletes the existing root
# clawville.world / api.clawville.world pointing at Railway. That lets you
# test the Hetzner deploy end-to-end before swapping production over.
CF_WEB_SUBDOMAIN=new              # → new.clawville.world
CF_API_SUBDOMAIN=api-new          # → api-new.clawville.world
CF_COOLIFY_SUBDOMAIN=coolify      # → coolify.clawville.world (admin UI)

# Keep records DNS-only (grey cloud) during initial Let's Encrypt issuance.
# Flip to proxied (orange cloud) in the Cloudflare UI after certs are issued.
CF_PROXIED=false
