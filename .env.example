# Database
DATABASE_URL=postgresql://user:password@localhost:5432/clawville

# LLM backends. Both text generation AND embeddings moved from Gemini to OpenAI
# on 2026-06-05 (Gemini text billing was dunning-blocked / 403; embeddings
# followed since the embeddings table was empty, so no re-embed migration was
# needed). Anthropic was fully removed in the ultrathink decommission (2026-04-10).

# REQUIRED. Backs BOTH text generation AND embeddings for all non-OpenClaw runtimes:
#   - text: openai-text-provider (TEXT_SMALL / TEXT_LARGE), NPC banter
#     (npc-conversation-engine.ts), and transient chat
#   - embeddings: openai-embedding-provider (TEXT_EMBEDDING) + embed-text.ts helper
# Optional text-model overrides:
#   OPENAI_SMALL_MODEL          (default gpt-4o-mini)
#   OPENAI_LARGE_MODEL          (default gpt-4o)
# Embedding model + dimension are PINNED in code (text-embedding-3-small,
# 1536-dim) and are NOT env-overridable. The request body, the boot probe, and
# the embed-text helper all use the same literal constants so stored and query
# vectors can never diverge. Changing the dimension routes embeddings to a
# different pgvector column and requires a re-embed migration, so it is a
# deliberate code change, not an env tweak. (OPENAI_EMBEDDING_MODEL /
# OPENAI_EMBEDDING_DIMENSIONS are no longer read.)
OPENAI_API_KEY=
# OPENAI_SMALL_MODEL=gpt-4o-mini
# OPENAI_LARGE_MODEL=gpt-4o
# (Gemini fully removed 2026-06-16 — runtime, skill-md generator, AND the Hermes
#  character-turnaround image script all run on OpenAI now. No GEMINI_API_KEY.)

# ElizaOS
ELIZA_ALLOW_DESTRUCTIVE_MIGRATIONS=true

# API
PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Phase 5 — Agent-issued magic-link tickets (GET /api/auth/enter?t=...).
# Seconds before an unused ticket expires. Default 600 (10 min); clamped to
# [60, 3600] in apps/api/src/services/session-ticket-service.ts.
AGENT_SESSION_TICKET_TTL_SECONDS=600

# Phase 4 — Solana / x402 payments
# Master key for encrypting treasury_wallets + vanity_keypairs (AES-256-GCM, 64-char hex)
# DEPRECATED as of Phase 5.1 — new wallet rows use envelope encryption via the
# Cloudflare Worker (see CLOUDFLARE_WORKER_URL below). Keep set until every v1
# row has been rewrapped.
VANITY_ENCRYPTION_KEY=
# Base58 public key of the Phase 4 merchant wallet
CLAWVILLE_MERCHANT_WALLET_PUBKEY=

# Phase 5.1 — Envelope encryption via Cloudflare Secrets Store Worker.
# Deploy the Worker first: see infra/cf-secrets-worker/README.md.
# URL of the deployed Worker (no trailing slash).
CLOUDFLARE_WORKER_URL=https://clawville-secrets.<account>.workers.dev
# Bearer token set via `wrangler secret put WORKER_BEARER` on the Worker.
# Must match exactly — rotate independently of the KEK.
CLOUDFLARE_WORKER_BEARER=

# Phase 5.1 — Service issuer keypair (ed25519). Generate with:
#   bun run scripts/generate-service-issuer-keypair.ts
# SK is the secret. PK is published at /.well-known/clawville-issuer.json.
CLAWVILLE_SERVICE_ISSUER_SK=
CLAWVILLE_SERVICE_ISSUER_PUBKEY=

# Phase 5.1 — 'scape cross-world portal (plan §6.2, §7).
# URL where we POST signed hosted-session-issue requests. No trailing slash.
SCAPE_HOSTED_SESSION_URL=https://xrsps.com/hosted-session/issue
# Origin of the 'scape web client — we redirect users here with
# ?sessionToken=... after a successful outbound crossing.
SCAPE_WEB_ORIGIN=https://xrsps.com
# Inbound partner signature allowlist. JSON object keyed by partner id;
# each value is the partner's base58 ed25519 pubkey. Empty/missing means
# all inbound /api/portal/mint-for-<partner> + /api/portal/accept-<partner>-link
# calls are rejected with 401. Add the "hatcher" key (partner #2) once
# Hatcher shares their service-issuer pubkey — no code change needed
# (loadPartnerPubkeys reads every key). CLAWVILLE_SERVICE_ISSUER_SK/_PUBKEY
# above are reused unchanged for all partners (one outbound keypair).
PARTNER_PUBKEYS={"scape":"","hatcher":""}
# Partner SCOPED READ KEYS (Hatcher Phase C, 2026-06-01) live in the DB
# (`partner_api_keys` table), NOT an env var. They gate the high-volume skill
# read surfaces (`/api/skills/manifest.json`, `/protocol/skill.md`,
# `/:buildingId/skill.md`) separately from the ed25519 PARTNER_PUBKEYS allowlist
# above (which gates the signed portal/registration writes). Mint one with:
#   bun run scripts/mint-partner-key.ts --partner=hatcher \
#     --scopes=skills:read --label="Hatcher prod read key"
# The token is printed ONCE (only its sha256 hash is stored — no recovery path);
# send it to the partner to use as `Authorization: Bearer <token>`. Revoke via
# `UPDATE partner_api_keys SET revoked_at = now() WHERE id = '<id>';`.

# Hatcher cross-world portal (partner #2, 2026-06-01 — plan §2).
# URL where we POST signed hosted-session-issue requests for CV → Hatcher.
# No trailing slash. Placeholder path; confirm the exact endpoint with
# Hatcher before prod (plan §7). Overridable per-box on Coolify.
HATCHER_HOSTED_SESSION_URL=https://hatcher.host/hosted-session/issue
# Origin of the Hatcher web client — we redirect users here with
# ?sessionToken=... after a successful outbound crossing.
HATCHER_WEB_ORIGIN=https://hatcher.host

# Metrics dashboard — /dash admin surface + Telegram alerts (shipped 2026-04-21)
# Comma-separated list of user UUIDs allowed to hit /api/dashboard/*
ADMIN_USER_IDS=
# itachi-debug bot credentials (read from ~/.itachi-api-keys locally)
ITACHI_DEBUG_BOT_TOKEN=
ITACHI_DEBUG_CHAT_ID=
# ISO date the dashboard displays as "Measuring since ..." — when the events
# table began recording. Defaults to 2026-04-21 in the code.
METRICS_MEASUREMENT_START=2026-04-21
