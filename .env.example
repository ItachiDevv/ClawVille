SAP_ENABLED=false
SAP_ESCROW_ENABLED=false
SAP_DRY_RUN=true
SAP_CLUSTER=devnet
# Option C — OOBE USDC SelfReport escrow GATE (verify-before-release). Sits ON TOP
# OF SAP_ESCROW_ENABLED: the V1 USDC create/deposit/settle/withdraw + verification
# gate is DARK unless SAP_ENABLED && SAP_ESCROW_ENABLED && SAP_USDC_ESCROW_ENABLED
# are ALL true (and even then SAP_DRY_RUN=true simulates only, never broadcasts).
SAP_USDC_ESCROW_ENABLED=false
# Default USDC escrow expiry window (seconds) when an absolute expiry isn't pinned.
# Default 7 days (604800); floor 1h.
SAP_USDC_ESCROW_DEFAULT_EXPIRY_SECONDS=604800
METRICS_MEASUREMENT_START=2026-04-21
