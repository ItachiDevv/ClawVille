# Database
DATABASE_URL=postgresql://user:password@localhost:5432/clawville

# LLM backends. Both text generation AND embeddings moved from Gemini to OpenAI
# on 2026-06-05 (Gemini text billing was dunning-blocked / 403; embeddings
# followed since the embeddings table was empty, so no re-embed migration was
# needed). Anthropic was fully removed in the ultrathink decommission (2026-04-10).

# REQUIRED. Backs BOTH text generation AND embeddings for all non-OpenClaw runtimes:
#   - text: openai-text-provider (TEXT_SMALL / TEXT_LARGE), NPC banter
#     (npc-conversation-engine.ts), and transient chat
#   - embeddings: openai-embedding-provider (TEXT_EMBEDDING) + embed-text.ts helper
# Optional text-model overrides:
#   OPENAI_SMALL_MODEL          (default gpt-4o-mini)
#   OPENAI_LARGE_MODEL          (default gpt-4o)
# Embedding model + dimension are PINNED in code (text-embedding-3-small,
# 1536-dim) and are NOT env-overridable. The request body, the boot probe, and
# the embed-text helper all use the same literal constants so stored and query
# vectors can never diverge. Changing the dimension routes embeddings to a
# different pgvector column and requires a re-embed migration, so it is a
# deliberate code change, not an env tweak. (OPENAI_EMBEDDING_MODEL /
# OPENAI_EMBEDDING_DIMENSIONS are no longer read.)
OPENAI_API_KEY=
# OPENAI_SMALL_MODEL=gpt-4o-mini
# OPENAI_LARGE_MODEL=gpt-4o
# (Gemini fully removed 2026-06-16 — runtime, skill-md generator, AND the Hermes
#  character-turnaround image script all run on OpenAI now. No GEMINI_API_KEY.)

# ElizaOS
ELIZA_ALLOW_DESTRUCTIVE_MIGRATIONS=true

# API
PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Phase 5 — Agent-issued magic-link tickets (GET /api/auth/enter?t=...).
# Seconds before an unused ticket expires. Default 600 (10 min); clamped to
# [60, 3600] in apps/api/src/services/session-ticket-service.ts.
AGENT_SESSION_TICKET_TTL_SECONDS=600

# Phase 4 — Solana / x402 payments
# Master key for encrypting treasury_wallets + vanity_keypairs (AES-256-GCM, 64-char hex)
# DEPRECATED as of Phase 5.1 — new wallet rows use envelope encryption via the
# Cloudflare Worker (see CLOUDFLARE_WORKER_URL below). Keep set until every v1
# row has been rewrapped.
VANITY_ENCRYPTION_KEY=
# Base58 public key of the Phase 4 merchant wallet (also the x402 on-ramp payTo)
CLAWVILLE_MERCHANT_WALLET_PUBKEY=

# Tokenomics F2 — USDC->vCLAW on-ramp (x402). DEVNET-first + gated; the on-ramp
# returns 503 until CLAWVILLE_MERCHANT_WALLET_PUBKEY (the payTo) is set.
# Facilitator preset: 'cdp' (default) | 'payai' | 'mock'.
X402_FACILITATOR_PRESET=cdp
# 'true' ONLY on the staging box to mount the test mock facilitator. The mock
# rubber-stamps settlement (would MINT FREE vCLAW), so the API REFUSES TO BOOT if
# this (or PRESET=mock) is set while CLAWVILLE_ENV != 'staging'. Leave UNSET in prod.
X402_MOCK_FACILITATOR=
# Optional override URL for the mock facilitator (staging harness only).
X402_MOCK_FACILITATOR_URL=
# On-ramp settle network: 'devnet' (default) | 'mainnet' (a deliberate flip).
X402_TOPUP_NETWORK=devnet
# Generic x402 checkout: how long a checkout may sit in the durable `settling`
# state WITHOUT a captured signature before it is treated as a DEAD claim and
# moved to `reconcile` (money-state unknown → chain-check, NEVER an auto-retry of
# the facilitator). Default 300000 (5 min); floor 30000. MUST exceed the
# facilitator settle timeout (~120s) so a live in-flight settle is never
# mis-reconciled. Rarely tuned.
X402_CHECKOUT_SETTLING_STALE_MS=
# General avatar-to-avatar PayAI payment cap in integer cents. Default 1000
# ($10); invalid, unsafe, or out-of-range values fall back to the default.
AGENT_PAY_MAX_USD_CENTS=1000
# RPC used to read/send the x402 payment on the CAIP-2 network selected by
# X402_NETWORK. Optional; defaults to the matching public Solana endpoint.
AGENT_PAY_RPC_URL=
# A `settling` agent payment with no captured signature older than this is
# quarantined to `reconcile` and NEVER auto-retried. Default 300000; floor
# 180000 so a live PayAI settle cannot be misclassified as stale.
AGENT_PAY_STALE_MS=300000

# ── EARNED import + sybil verification (E1/E2, DEFAULT OFF) ────────────────
# Literal true enables the admin import and scheduled payer-verification job.
# Entry rake is founder-locked to ZERO; the only loop fee is E3's 444bps exit.
TOKENOMICS_EARN_ENABLED=
TOKENOMICS_EARN_RAKE_FLOOR_BPS=0
# Inner per-wallet/earner cap and outer first-funder-cluster/earner cap share
# this USD limit per fixed epoch. Wallet cap applies synchronously; cluster cap
# applies when pending payer verification resolves.
TOKENOMICS_EARN_PAIR_CAP_USD=100
TOKENOMICS_EARN_EPOCH_DAYS=7
TOKENOMICS_EARN_VEST_DAYS=7
TOKENOMICS_EARN_PAYER_MIN_AGE_DAYS=7
TOKENOMICS_EARN_PAYER_MIN_SIGNATURES=2
TOKENOMICS_EARN_VERIFY_BATCH_SIZE=25
TOKENOMICS_EARN_VERIFY_POLL_MS=300000
TOKENOMICS_EARN_VERIFY_MAX_PAGES=5

# ── EARNED exit rail (E3, GATED DARK / REAL MONEY) ──────────────────────────
# DEFAULT OFF. Do not set literal 'true' until BOTH launch gates are evidenced:
# G2 funded adversarial devnet wash-arb is unprofitable; G3 founder legal
# clearance covers MSB/money-transmitter treatment and exit-side KYC/sanctions.
# Route and every service entry independently enforce the literal comparison.
TOKENOMICS_REDEEM_ENABLED=
# Minimum request in whole vCLAW. Default 100 (= $1 gross at the 1¢ quote unit).
# Invalid/non-positive values fall back to 100. One request is hard-capped at
# 1,000,000 vCLAW ($10k) by the existing CLV buy-intent ceiling.
TOKENOMICS_REDEEM_MIN_VCLAW=100
# Same durability knob for the ct-topup on-ramp (Codex money-path fast-follow):
# how long a top-up may sit in `settling` WITHOUT a captured signature before it
# is reconciled (money-state unknown, never an auto-retry). Default 300000; floor
# 30000; MUST exceed the facilitator settle timeout (~120s).
CT_TOPUP_SETTLING_STALE_MS=
# x402 settle RECONCILER apply gate (Codex round-2 MEDIUM). The reconciler
# (apps/api/scripts/x402/reconcile-checkouts.ts → services/x402-reconcile.ts)
# enumerates `reconcile` rows and classifies each into a resolution
# recommendation. v1 is DRY-RUN ONLY: 'true' makes it REFUSE to run — the apply
# path (capture+fulfill / refund-with-signature / no-money terminal) + its
# live-chain parser are Codex-review-gated. Leave unset.
RECONCILE_APPLY=

# ── Tokenomics C3 — CLV buy-queue swap executor (DRY-RUN ONLY) ────────────────
# HARD GATE: MUST stay unset/false. 'true' makes the API REFUSE TO BOOT (module-
# load throw in clv-swap-executor.ts) — live CLV swap execution is Codex-review-
# gated; the shipped worker only LOGS the clip plan it would execute. The DARK
# live plumbing (clv-swap-live.ts: funding sweep + atomic claim + Jupiter leg)
# ALSO re-asserts this gate default-OFF at every entrypoint — opening the seam
# is a Codex-reviewed code change (remove the module-load throw), never an env
# flip alone.
CLV_SWAP_EXECUTE=
# Per-clip price-impact cap in bps against one-side pool depth (≈liquidity/2).
# Default 100 (=1%), floor 1, cap 10000.
CLV_SWAP_MAX_IMPACT_BPS=100
# Dry-run worker scan interval (ms). Default 300000 (5 min), floor 30000.
CLV_SWAP_POLL_MS=300000
# Intended spacing between clips in a plan (ms; informational in dry-run — the
# dark live path sleeps this long between confirmed clips).
# Default 60000, floor 1000.
CLV_SWAP_CLIP_SPACING_MS=60000
# ── GoLive executors (DARK live path — read ONLY behind the CLV_SWAP_EXECUTE
#    seam; harmless while the gate is shut) ───────────────────────────────────
# Jupiter-leg max slippage in bps. Drives BOTH the Jupiter quote slippageBps AND
# the ORACLE-derived on-chain min-out floor (a Jupiter quote whose threshold is
# below the oracle floor is refused). Default 100 (=1%), floor 1, cap 1000.
CLV_SWAP_SLIPPAGE_BPS=100
# Jupiter API base — HOST-ALLOWLISTED (SSRF guard, 2026-07-08): ONLY
# https://lite-api.jup.ag (default, keyless) and https://api.jup.ag (the paid
# base — an ops swap, same wire shape) are accepted. Anything else (non-https,
# credentials, off-allowlist host) falls back to the default with a loud warn —
# the swap wire can only ever point at Jupiter itself.
CLV_SWAP_JUPITER_BASE_URL=
# How old (ms) an 'executing' clv_buy_queue claim must be before the live tick
# pages ops (alert-error 'warning', source clv-swap-live). ALERT-ONLY: a stuck
# row is NEVER auto-resumed/auto-retried — its confirmed fills are durable in
# tx_signatures and resolution is a manual reconcile decision. Default 300000;
# hard floor 180000 (mirrors MARKET_PAYOUT_STALE_MS — must exceed a live clip
# send+confirm cycle so an in-flight execution is never mis-paged).
CLV_SWAP_EXECUTING_STALE_MS=

# ── Tokenomics C2 — MoonPay card→USDC rail (TEST-MODE ONLY) ──────────────────
# Sandbox keys from https://dashboard.moonpay.com (test mode). The widget base
# URL is CODE-PINNED to buy-sandbox.moonpay.com and the URL builder REFUSES a
# non-pk_test_ key — going live is a Codex-reviewed code change, not a key swap.
# Publishable key (pk_test_…) — appears in signed widget URLs by design.
MOONPAY_API_KEY=pk_test_placeholder
# URL-signing secret (sk_test_…). NEVER logged or echoed.
MOONPAY_SECRET_KEY=sk_test_placeholder
# Webhook signature key (wk_test_…) verifying Moonpay-Signature-V2. NEVER logged.
MOONPAY_WEBHOOK_KEY=wk_test_placeholder
# Card pass-through fee in bps surfaced in the widget-url quote (default 450 = +4.5%).
MOONPAY_CARD_FEE_BPS=450

# ── Tokenomics C4 — P2P marketplace v1 (SETTLEMENT GATED OFF) ────────────────
# Marketplace SETTLEMENT gate. MUST stay unset/false until the C4 money path
# clears its review chain (token-economy manager → adversarial money auditor →
# Codex). Only the literal string 'true' enables; while off, the checkout
# quote/preflight/fulfiller all refuse 'marketplace_settle_disabled' (no 402
# is ever issued). Listing/browse/cancel work regardless of this flag.
MARKETPLACE_SETTLE_ENABLED=
# CLV Resident-license threshold to LIST (uiAmount — human token count) read
# from the seller's wallet (human: linked self-custody; agent: its custodial
# avatar wallet). Default 50000. Retunable; 0/invalid falls back to the
# default — the license gate can be lowered but never disabled via env.
MARKET_SELLER_MIN_CLV=50000
# ── GoLive executors — DEED TRANSFER + PAYOUT (BOTH DARK, default OFF) ───────
# Deed-transfer executor gate (market-deed-transfer-executor.ts). MUST stay
# unset/false: flips land_parcels.owner_avatar_id seller→buyer for SETTLED
# land_deed settlements (pure DB, one tx, under-lock owner re-verify, never a
# forced flip). Opening it is a Codex+land-reviewed change. Nothing is wired
# into index.ts boot either way.
MARKET_DEED_TRANSFER_ENABLED=
# Payout executor gate (market-payout-executor.ts). MUST stay unset/false:
# sends the seller's 95.56% CLV + the treasury's 4.44% rake CLV on-chain from
# the clv-swap wallet (Token-2022 TransferChecked; capture-before-send;
# ambiguous ⇒ reconcile-never-retry; deed_transferred_at is the precondition —
# deed FIRST, payout second). Also guarded by the mainnet/real-facilitator
# network guard (devnet/mock can never reach a real send).
MARKET_PAYOUT_EXECUTE=
# The rake DESTINATION — base58 pubkey where the treasury's 4.44% CLV rake
# accrues. FAIL CLOSED: unset/invalid ⇒ the payout executor refuses before
# anything signs (we never guess where house CLV goes). Read-only destination —
# its secret never exists in the API process.
MARKET_RAKE_TREASURY_PUBKEY=
# How old (ms) a 'sending' payout claim must be before the resume path may
# take it over (crash recovery — forward-only chain-check, never a re-send).
# Default 300000; hard floor 180000 (must exceed a live send+confirm cycle so
# an in-flight payout is never mis-resumed).
MARKET_PAYOUT_STALE_MS=

# ── Custodial wallet WITHDRAW (DARK, default OFF) ────────────────────────────
# Withdraw gate (services/wallet-withdraw-executor.ts + routes/wallet-withdraw.ts).
# MUST stay unset/false until the flow clears legal review of the custody model
# (wallets.ts JSDoc caveat) + the review chain (token-economy manager →
# adversarial money auditor → Codex). Only the literal 'true' enables; while
# off, POST /api/wallet/withdraw refuses with a typed 503 `withdraw_disabled`.
# When ON it SIGNS with users' custodial keypairs and moves REAL mainnet
# SOL/USDC/CLV (capture-before-send; ambiguous ⇒ reconcile-never-retry;
# Idempotency-Key required). GET /api/wallet/balances is read-only and live
# regardless. LEDGER-UNTOUCHED — never vCLAW, never avatars.clawTokens.
WALLET_WITHDRAW_ENABLED=
# (Daily caps REMOVED 2026-07-09 by founder decision — the old
# WALLET_WITHDRAW_DAILY_CAP_{SOL,USDC,CLV} knobs are no longer read. The only
# per-request limits are the balance/fee guards + the CLV hold consent gate.)
# How old (ms) a 'sending' withdrawal claim must be before the resume path may
# take it over. Default 300000; hard floor 180000 (same rationale as
# MARKET_PAYOUT_STALE_MS — an in-flight withdrawal is never mis-resumed).
WALLET_WITHDRAW_STALE_MS=
# Resume-worker poll cadence (ms). The worker is boot-wired in index.ts but
# DARK-GATED — it only starts when WALLET_WITHDRAW_ENABLED='true'. Each tick
# chain-checks stale 'sending' claims FORWARD-ONLY (never re-signs/re-sends a
# captured signature) and pages ops (alertError, warning) for every row that
# resolves to 'reconcile'. Default 300000 (5 min); floor 60000.
WALLET_WITHDRAW_RESUME_POLL_MS=

# Marketplace LISTING-EXPIRY sweeper cadence (task D). The boot-wired sweeper
# (services/market-listing-expiry-sweeper.ts) flips expired `active` listings to
# the terminal `expired` state and RELEASES their deed lock so an abandoned
# expired listing can't park land's rent eviction forever. NOT a money path —
# no CT/CLV/USDC; runs LIVE (not gated). Default 3600000 (1h), floor 300000.
MARKET_LISTING_EXPIRY_SWEEP_PERIOD_MS=

# Phase 5.1 — Envelope encryption via Cloudflare Secrets Store Worker.
# Deploy the Worker first: see infra/cf-secrets-worker/README.md.
# URL of the deployed Worker (no trailing slash).
CLOUDFLARE_WORKER_URL=https://clawville-secrets.<account>.workers.dev
# Bearer token set via `wrangler secret put WORKER_BEARER` on the Worker.
# Must match exactly — rotate independently of the KEK.
CLOUDFLARE_WORKER_BEARER=

# Phase 5.1 — Service issuer keypair (ed25519). Generate with:
#   bun run scripts/generate-service-issuer-keypair.ts
# SK is the secret. PK is published at /.well-known/clawville-issuer.json.
CLAWVILLE_SERVICE_ISSUER_SK=
CLAWVILLE_SERVICE_ISSUER_PUBKEY=

# Phase 5.1 — 'scape cross-world portal (plan §6.2, §7).
# URL where we POST signed hosted-session-issue requests. No trailing slash.
SCAPE_HOSTED_SESSION_URL=https://xrsps.com/hosted-session/issue
# Origin of the 'scape web client — we redirect users here with
# ?sessionToken=... after a successful outbound crossing.
SCAPE_WEB_ORIGIN=https://xrsps.com
# Inbound partner signature allowlist. JSON object keyed by partner id;
# each value is the partner's base58 ed25519 pubkey. Empty/missing means
# all inbound /api/portal/mint-for-<partner> + /api/portal/accept-<partner>-link
# calls are rejected with 401. Add the "hatcher" key (partner #2) once
# Hatcher shares their service-issuer pubkey — no code change needed
# (loadPartnerPubkeys reads every key). CLAWVILLE_SERVICE_ISSUER_SK/_PUBKEY
# above are reused unchanged for all partners (one outbound keypair).
# The "covenant" key gates the READ-only Covenant verification surface
# (/api/partner/covenant/*, 2026-07-03) — set it to Covenant's base58 ed25519
# pubkey; leaving it "" keeps that surface fail-closed (503 partner_not_configured).
PARTNER_PUBKEYS={"scape":"","hatcher":"","covenant":""}
# Partner SCOPED READ KEYS (Hatcher Phase C, 2026-06-01) live in the DB
# (`partner_api_keys` table), NOT an env var. They gate the high-volume skill
# read surfaces (`/api/skills/manifest.json`, `/protocol/skill.md`,
# `/:buildingId/skill.md`) separately from the ed25519 PARTNER_PUBKEYS allowlist
# above (which gates the signed portal/registration writes). Mint one with:
#   bun run scripts/mint-partner-key.ts --partner=hatcher \
#     --scopes=skills:read --label="Hatcher prod read key"
# The token is printed ONCE (only its sha256 hash is stored — no recovery path);
# send it to the partner to use as `Authorization: Bearer <token>`. Revoke via
# `UPDATE partner_api_keys SET revoked_at = now() WHERE id = '<id>';`.

# Covenant verification partner — IP allowlist for the READ-only surface
# (/api/partner/covenant/*, 2026-07-03). Comma-separated EXACT client IPs allowed
# to reach the surface, matched against the Cloudflare-authoritative
# `cf-connecting-ip`. Defense-in-depth ON TOP of the ed25519 partner signature
# (PARTNER_PUBKEYS.covenant above). Empty/missing keeps the surface fail-closed
# (503 partner_not_configured — BOTH the pubkey AND at least one IP are required).
# Use the EXACT textual form CF emits (IPv4 dotted-quad; if IPv6/IPv4-mapped
# `::ffff:...` ever appears, list that exact string — a mismatch fails safe as 403).
COVENANT_ALLOWED_IPS=62.242.144.246

# Hatcher cross-world portal (partner #2, 2026-06-01 — plan §2).
# URL where we POST signed hosted-session-issue requests for CV → Hatcher.
# No trailing slash. Placeholder path; confirm the exact endpoint with
# Hatcher before prod (plan §7). Overridable per-box on Coolify.
HATCHER_HOSTED_SESSION_URL=https://hatcher.host/hosted-session/issue
# Origin of the Hatcher web client — we redirect users here with
# ?sessionToken=... after a successful outbound crossing.
HATCHER_WEB_ORIGIN=https://hatcher.host

# Metrics dashboard — /dash admin surface + Telegram alerts (shipped 2026-04-21)
# Comma-separated list of user UUIDs allowed to hit /api/dashboard/*
ADMIN_USER_IDS=
# itachi-debug bot credentials (read from ~/.itachi-api-keys locally)
ITACHI_DEBUG_BOT_TOKEN=
ITACHI_DEBUG_CHAT_ID=
# ISO date the dashboard displays as "Measuring since ..." — when the events
# table began recording. Defaults to 2026-04-21 in the code.
METRICS_MEASUREMENT_START=2026-04-21

# ── SAP (Synapse Agent Protocol) on-chain rail — DEFAULT-SAFE (devnet + dry-run) ──
# These are the DEFAULT-SAFE values, NOT a permanent resting state. The validation
# ladder is: devnet-on-staging (done) → MAINNET-on-staging → prod fully ON. The whole
# layer is dark unless SAP_ENABLED; the money/stake rail needs SAP_ESCROW_ENABLED on
# top; SAP_DRY_RUN=true builds + simulates ONLY (never broadcasts).
# MAINNET is a TWO-LOCK gate: LOCK 1 = the SAP_ALLOW_MAINNET CODE constant (now TRUE,
# reviewed-flipped 2026-07-10, in apps/api/src/services/sap/sap-config.ts); LOCK 2 =
# SAP_CLUSTER=mainnet PER BOX. A box stays fully devnet unless it sets SAP_CLUSTER=mainnet,
# and real funds move only with SAP_DRY_RUN=false + the enable flags. On a MAINNET box you
# MUST set a paid SAP_RPC_URL (Helius mainnet) — the public RPC is rate-limited + unsafe
# for real traffic.
SAP_ENABLED=false
SAP_ESCROW_ENABLED=false
SAP_DRY_RUN=true
SAP_CLUSTER=devnet
# Option C — OOBE USDC SelfReport escrow GATE (verify-before-release). Sits ON TOP
# OF SAP_ESCROW_ENABLED: the V1 USDC create/deposit/settle/withdraw + verification
# gate is DARK unless SAP_ENABLED && SAP_ESCROW_ENABLED && SAP_USDC_ESCROW_ENABLED
# are ALL true (and even then SAP_DRY_RUN=true simulates only, never broadcasts).
SAP_USDC_ESCROW_ENABLED=false
# Default USDC escrow expiry window (seconds) when an absolute expiry isn't pinned.
# Default 7 days (604800); floor 1h.
SAP_USDC_ESCROW_DEFAULT_EXPIRY_SECONDS=604800
# Optional: override the RPC + program id. Defaults are the cluster's PUBLIC RPC + the
# canonical program id. Operators MUST set a paid SAP_RPC_URL (Helius) before real
# traffic — REQUIRED on a mainnet box (public mainnet RPC is rate-limited + unsafe).
# SAP_RPC_URL=
# SAP_PROGRAM_ID=
# USDC-rail bounty reward FLOOR (whole USDC). Default 10; clamped to an integer >= 1.
# Set to 1 on the mainnet smoke box so a funded 1-USDC bounty runs without an 11-USDC
# top-up. USDC rail ONLY — the CT rail floor stays 10.
# USDC_BOUNTY_REWARD_MIN=10

# ── Poker CASH GAMES — house tables + seeded bots (2026-06-22) ────────────────
# Always-on `source='house'` cash tables auto-scaled per tier and populated by a
# small pool of seeded bots, so a visitor always finds a live game. All knobs are
# read by `services/poker/cash-house-config.ts`; defaults are the founder-locked
# values, so leaving these UNSET reproduces production behavior.
#
# Master switch — set to false on local/dev to run WITHOUT any house tables/bots
# (the scaler no-ops). Default true.
CASH_HOUSE_SCALER_ENABLED=true
# How many open house tables the scaler keeps PER TIER. Defaults 2 / 2 / 1.
CASH_HOUSE_TABLES_LOW=2
CASH_HOUSE_TABLES_MID=2
CASH_HOUSE_TABLES_HIGH=1
# Scaler sweep cadence (ms) — how often it re-checks + refills the per-tier deficit.
# Default 45000 (floor 5000).
CASH_HOUSE_SCALER_INTERVAL_MS=45000
# Autonomous self-drive TICK cadence (ms) — how often seeded bots are advanced so a
# solo-human-plus-bots (or bot-only) table keeps dealing without a human poke. MUST
# be well under the sim's turnClock (25000) + grace (5000); clamped to [250, 20000].
# Default 1500.
CASH_TABLE_TICK_MS=1500
# Max bots seated per house table (cap). Default 3.
CASH_HOUSE_SEEDED_SLOTS_PER_TABLE=3
# Target TOTAL occupied seats (human + bots) the fill aims for — a solo human gets up
# to ~2 bot opponents (a small live game, NOT a packed 6-max felt). Default 3 (floor 2).
CASH_HOUSE_FILL_TARGET_SEATS=3
# Bot pool size M — must cover Σ(N_tier × seededAgentSlots) = 15 max concurrent +
# headroom. Default 24.
CASH_HOUSE_BOT_POOL_SIZE=24
# One-time house-bank bankroll seed target (CT) — the ONLY CT mint in the house-bot
# system, guarded so a restart only tops up a genuine deficit, never re-mints.
# Default 100000.
CASH_HOUSE_BANK_BANKROLL=100000
# Low-balance alarm threshold (CT) — a drained house bank below this on restart is
# topped back up to the bankroll target (and warned). Default 10000.
CASH_HOUSE_BANK_LOW_ALARM=10000
# Hermes host-it-for-me cognition gate (magic-link onboarding D7, 2026-07-02).
# When 'true' (STAGING-ONLY intent), in-world bodies of identityType 'hermes'
# agents route reactive/ambient cognition to a ClawVille-hosted Hermes runtime
# at the HARDCODED server-side constant http://localhost:8642 (never
# caller-supplied — the general SSRF guard still rejects all caller localhost
# URLs). Unset/false ⇒ hermes agents behave like nanoclaw (self-managed pull,
# fail-soft '' cognition). Requires an actual hermes runtime (or the mock:
# apps/api/scripts/agent-connect/mock-hermes-server.ts) listening on 8642.
HERMES_LOCAL_GATEWAY_ENABLED=false
# Same-box shared secret for the local Hermes runtime's OpenAI-compat API
# (2026-07-08, real-runtime deploy). Hermes >=0.12 refuses to start its API
# server without API_SERVER_KEY, even bound to 127.0.0.1 — set the SAME value
# here and as API_SERVER_KEY on the hermes sidecar. When set, chatHermesLocal
# sends it as `Authorization: Bearer`. Unset => bare POST (the mock-hermes
# harness needs no key). Never logged; never leaves localhost.
HERMES_LOCAL_GATEWAY_KEY=
# Leash (ms) for a hermes-local cognition POST. Default 10000; clamped
# [1000, 30000]. The real hosted Hermes agent loop measured ~7.3s idle on
# qwen3.6:27b, so staging runs 20000 to survive GPU contention. Fail-soft
# behavior on timeout is unchanged (body is silent that turn).
HERMES_LOCAL_TIMEOUT_MS=10000
# OpenClaw host-it-for-me cognition gate (D-openclaw, 2026-07-08) — the exact
# mirror of HERMES_LOCAL_GATEWAY_ENABLED. When 'true' (STAGING-ONLY intent), a
# GATEWAY-LESS 'openclaw' connect (an openclaw agent that arrives WITHOUT its own
# gatewayUrl) has its reactive/ambient cognition routed to a ClawVille-hosted
# OpenClaw runtime at the HARDCODED server-side constant http://localhost:8643
# (never caller-supplied — the general SSRF guard still rejects all caller
# localhost URLs). A BYO openclaw WITH its own gateway is byte-identical under both
# gate states (the hosted path never captures it). Unset/false ⇒ a gateway-less
# openclaw behaves as it does today (declared 'openai-compat', fail-soft against
# the dummy gateway). Requires an actual OpenClaw OpenAI-compat runtime (or the
# mock: apps/api/scripts/agent-connect/mock-openclaw-server.ts) listening on 8643.
OPENCLAW_LOCAL_GATEWAY_ENABLED=false
# Same-box shared secret for the local OpenClaw gateway's OpenAI-compat API
# (2026-07-08) — the exact mirror of HERMES_LOCAL_GATEWAY_KEY. The real OpenClaw
# gateway (github.com/openclaw/openclaw) exposes OpenAI-compat /v1/chat/completions
# and may require an API key even on loopback; set the SAME value here and on the
# openclaw sidecar. When set, chatOpenclawLocal sends it as `Authorization: Bearer`.
# Unset => bare POST (the mock-openclaw harness needs no key). Never logged; never
# leaves localhost.
OPENCLAW_LOCAL_GATEWAY_KEY=
# Leash (ms) for an openclaw-local cognition POST. Default 10000; clamped
# [1000, 30000]. Mirrors HERMES_LOCAL_TIMEOUT_MS — the real OpenClaw agent loop on
# a local model is no faster than Hermes's ~7.3s idle, so staging runs 20000 to
# survive GPU contention. Fail-soft behavior on timeout is unchanged.
OPENCLAW_LOCAL_TIMEOUT_MS=10000
